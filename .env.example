DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rubric

# Signs the real-login session cookie. Generate a real one for any shared
# environment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-change-me

# AI is off by default; the app must be fully usable with this set to false.
AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
